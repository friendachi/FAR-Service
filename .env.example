# Supabase — Project Settings → API (หรือ API Keys)
# คัดลอกเป็น .env.local แล้วรีสตาร์ต `npm run dev`
NEXT_PUBLIC_SUPABASE_URL=
# ใช้ publishable key (sb_publishable_...) หรือ anon key แบบเดิมก็ได้ — ใส่อย่างใดอย่างหนึ่ง
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (ห้ามขึ้นต้นด้วย NEXT_PUBLIC_): ใช้สร้างบัญชีพนักงานและสคริปต์ seed
SUPABASE_SERVICE_ROLE_KEY=

# Facebook Page "FAR Trailer Rental Thailand" — โพสต์สาระน่ารู้อัตโนมัติ (ดู src/lib/facebook.ts)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# ที่อยู่เว็บจริง (ลิงก์ในโพสต์) เช่น https://farservice.co.th
NEXT_PUBLIC_SITE_URL=
# รหัสลับสำหรับงานตั้งเวลา (cron) เรียก /api/cron/facebook-articles
CRON_SECRET=

# LINE Official Account (Messaging API) — แจ้งเตือนพนักงานเมื่อลูกค้าส่งคำขอ (ดู src/lib/line-alert.ts)
LINE_CHANNEL_ACCESS_TOKEN=
# userId หรือ groupId ที่จะรับแจ้งเตือน คั่นด้วยจุลภาค
LINE_ALERT_TO=
